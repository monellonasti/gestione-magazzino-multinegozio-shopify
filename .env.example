# Copia questo file in .env. Nessun segreto qui dentro: le credenziali delle app Shopify restano nei loro file.

# demo = negozi inventati (nessun collegamento a Shopify); reale = i negozi veri, descritti in negozi.json
MODALITA=demo

# Rete: 0.0.0.0 = raggiungibile anche dal tablet sulla stessa rete del negozio
HOST=0.0.0.0
PORTA=8000

# Scritture sulle giacenze Shopify (spedizioni, ricezioni, rettifiche). Spente finche' non le accendi tu.
SCRITTURE_SHOPIFY=0
# Rettifiche da conteggio sui negozi veri (servono anche le scritture accese)
RETTIFICHE=0

# Ogni quanti minuti rileggere i negozi
SYNC_MINUTI=15

# I negozi veri: copia negozi.example.json in negozi.json (resta fuori da git). Altro percorso: NEGOZI_FILE=...
# NEGOZI_FILE=negozi.json

# File credenziali di ciascun negozio Shopify di negozi.json (SHOPIFY_SHOP o SHOPIFY_STORE, SHOPIFY_CLIENT_ID,
# SHOPIFY_CLIENT_SECRET), una riga ENV_<STORE> per ogni "store". Percorsi relativi a questa cartella.
ENV_A_CASSA=../negozio-a/.env
ENV_A_ONLINE=../negozio-a-online/.env
ENV_B_CASSA=../negozio-b/.env
